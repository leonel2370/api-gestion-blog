# ===========================================================================
# Variables d'environnement locales - NE PAS COMMITTER ce fichier
# Copiez-le : cp .env.example .env
# ===========================================================================

# --- Base de donnees (PostgreSQL, utilise par docker-compose) ---
POSTGRES_DB=blogdb
POSTGRES_USER=blog
POSTGRES_PASSWORD=blogpass

# --- Connexion Spring Boot a PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/blogdb
SPRING_DATASOURCE_USERNAME=blog
SPRING_DATASOURCE_PASSWORD=blogpass

# --- Schema Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
